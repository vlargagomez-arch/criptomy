# Base de datos (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# Riot Games API (gratis en developer.riotgames.com)
RIOT_API_KEY=

# Steam Web API (gratis en steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# PUBG API (gratis en developer.pubg.com)
PUBG_API_KEY=

# Wallet de escrow (donde se guardan los USDT de retos)
NEXT_PUBLIC_ESCROW_WALLET=

# Bot de pago automático
ESCROW_PRIVATE_KEY=
ESCROW_RPC_URL=https://ethereum.publicnode.com
ESCROW_CHAIN_ID=1
PLATFORM_FEE_BPS=500

# WalletConnect (opcional, para mobile)
NEXT_PUBLIC_WC_PROJECT_ID=

# Smart contract ChallengeEscrow (opcional)
NEXT_PUBLIC_CHALLENGE_ESCROW_ADDRESS=
