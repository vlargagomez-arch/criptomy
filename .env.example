# Base de datos (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# Riot Games API (gratis en developer.riotgames.com)
RIOT_API_KEY=

# Steam Web API (gratis en steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# PUBG API (gratis en developer.pubg.com)
PUBG_API_KEY=

# Wallet de escrow (donde se guardan los USDT de retos)
NEXT_PUBLIC_ESCROW_WALLET=

# Bot de pago automático
ESCROW_PRIVATE_KEY=
ESCROW_RPC_URL=https://ethereum.publicnode.com
ESCROW_CHAIN_ID=1
PLATFORM_FEE_BPS=500

# WalletConnect (opcional, para mobile)
NEXT_PUBLIC_WC_PROJECT_ID=

# Smart contract ChallengeEscrow (opcional)
NEXT_PUBLIC_CHALLENGE_ESCROW_ADDRESS=

# ============================================================
# NUEVAS VARIABLES (Notificaciones + Alertas + NFT)
# ============================================================

# Web Push notifications (VAPID keys)
# Generar con: npx tsx scripts/generate-vapid-keys.ts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@criptomy.app

# Cron job security (protege /api/cron/price-alerts-check)
# Generar con: openssl rand -hex 32
CRON_SECRET=

# Admin token para crear NFT Drops (protege /api/nft-drops POST)
# Generar con: openssl rand -hex 32
DROPS_ADMIN_TOKEN=

# Admin token para crear oportunidades en /admin
# Generar con: openssl rand -hex 32
OPPORTUNITIES_ADMIN_TOKEN=

# ============================================================
# ON-RAMP / OFF-RAMP (proveedores de compra/venta)
# ============================================================
# MoonPay (https://moonpay.com/business/developer-docs)
NEXT_PUBLIC_MOONPAY_API_KEY=
MOONPAY_SECRET_KEY=

# Transak (https://docs.transak.com)
NEXT_PUBLIC_TRANSAK_API_KEY=
TRANSAK_SECRET_KEY=

# Ramp Network (https://docs.ramp.network)
RAMP_API_KEY=
RAMP_SECRET_KEY=

# Coinbase Onramp (https://docs.cdp.coinbase.com/onramp)
COINBASE_ONRAMP_API_KEY=

# CoinGecko (https://www.coingecko.com/api/documentation)
COINGECKO_API_KEY=
