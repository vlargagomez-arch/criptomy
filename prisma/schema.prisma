// Schema Prisma - Plataforma P2P cripto sin KYC
// Modela: usuarios pseudónimos, ofertas, trades con escrow, mensajes, reputación, disputas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Usuario pseudónimo: sin email, sin KYC, sin datos PII.
// Se identifica solo por alias + dirección de wallet + clave pública.
model User {
  id              String   @id @default(cuid())
  alias           String   @unique // alias público tipo "satoshi_trader_87"
  walletAddress   String   @unique // dirección on-chain principal
  publicKey       String?  // clave pública para cifrado E2E (X25519)
  pgpFingerprint  String?  // huella PGP opcional para verificación off-chain
  bio             String?
  avatarSeed      String?  // seed para avatar determinístico (identicon)
  torOnly         Boolean  @default(false) // marca si el usuario exige conexión vía Tor
  reputationScore Float    @default(0) // 0-100, calculado a partir de feedbacks
  totalTrades     Int      @default(0)
  completedTrades Int      @default(0)
  disputedTrades  Int      @default(0)
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())

  offers          Offer[]
  tradesAsBuyer   Trade[]  @relation("TradeBuyer")
  tradesAsSeller  Trade[]  @relation("TradeSeller")
  feedbacksGiven  Feedback[]
  feedbacksRecv   Feedback[] @relation("FeedbackReceiver")
  messages        Message[]
  disputesOpened  Dispute[] @relation("DisputeOpener")
  disputesAgainst Dispute[] @relation("DisputeDefendant")

  // Gaming P2P
  gameAccounts        GameAccount[]
  challengesCreated   Challenge[] @relation("ChallengeCreator")
  challengesOpponent  Challenge[] @relation("ChallengeOpponent")
  challengesWon       Challenge[] @relation("ChallengeWinner")
}

// Oferta P2P: "vendo X BTC por Y COP vía Nequi"
model Offer {
  id              String   @id @default(cuid())
  type            String // BUY o SELL
  creatorId       String
  creator         User     @relation(fields: [creatorId], references: [id])

  // Asset en juego
  chain           String    // ETH, BTC, TRON, XMR
  asset           String   // símbolo: BTC, ETH, USDT, USDC, XMR, etc.
  amount          Float    // cantidad de cripto
  minAmount       Float?   // mínimo por trade parcial
  maxAmount       Float?   // máximo por trade parcial

  // Fiat o contra-asset
  currency        String   // COP, USD, EUR, MXN, ARS, VES, etc.
  pricePerUnit    Float    // precio en fiat por unidad de cripto
  priceType       String // FIXED o MARKET
  marketMargin    Float?   // % sobre/bajo precio de mercado si priceType = MARKET

  // Métodos de pago aceptados (CSV: "NEQUI,DAVIPLATA,PSE,CASH_IN_PERSON")
  paymentMethods  String

  // Términos legibles por el humano
  terms           String

  // Límites y ventana de pago
  paymentWindowMin Int     @default(60) // minutos máximos para pagar fiat
  escrowType      String @default("SMART_CONTRACT")

  // Estado
  status          String @default("ACTIVE")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trades          Trade[]
}

// Trade concreto entre dos partes sobre una oferta
model Trade {
  id              String   @id @default(cuid())
  offerId         String
  offer           Offer    @relation(fields: [offerId], references: [id])

  buyerId         String
  buyer           User     @relation("TradeBuyer", fields: [buyerId], references: [id])
  sellerId        String
  seller          User     @relation("TradeSeller", fields: [sellerId], references: [id])

  // Cantidades congeladas al abrir el trade
  cryptoAmount    Float
  fiatAmount      Float
  pricePerUnit    Float

  // Método de pago seleccionado y detalles de contacto (cifrados en reposo)
  paymentMethod   String
  paymentDetails  String   // cifrado con publicKey del vendedor

  // Estado del escrow on-chain
  escrowAddress   String?  // dirección del smart contract de escrow desplegado
  escrowTxHash    String?  // tx hash del depósito
  releaseTxHash   String?  // tx hash de liberación
  escrowChain     String?
  escrowAsset     String?

  // Estado del trade
  status          String @default("PENDING_ESCROW")
  disputeStarted  Boolean  @default(false)

  // Timestamps de cada etapa para auditoría
  escrowFundedAt  DateTime?
  paymentSentAt   DateTime?
  paymentConfirmedAt DateTime?
  releasedAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages        Message[]
  feedbacks       Feedback[]
  dispute         Dispute?
}

// Mensaje cifrado E2E entre las partes de un trade
model Message {
  id              String   @id @default(cuid())
  tradeId         String
  trade           Trade    @relation(fields: [tradeId], references: [id])
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id])

  // Contenido cifrado con la clave pública del destinatario (NaCl box / X25519)
  ciphertext      String
  nonce           String

  createdAt       DateTime @default(now())
}

// Feedback posterior a un trade (estilo LocalBitcoins)
model Feedback {
  id              String   @id @default(cuid())
  tradeId         String
  trade           Trade    @relation(fields: [tradeId], references: [id])
  fromUserId      String
  fromUser        User     @relation(fields: [fromUserId], references: [id])
  toUserId        String
  toUser          User     @relation("FeedbackReceiver", fields: [toUserId], references: [id])

  rating          Int      // 1-5 estrellas
  comment         String?
  trustScore      Int      // 0-100, subjetivo

  createdAt       DateTime @default(now())

  @@unique([tradeId, fromUserId]) // un feedback por usuario por trade
}

// Disputa abierta cuando las partes no se ponen de acuerdo
model Dispute {
  id              String   @id @default(cuid())
  tradeId         String   @unique
  trade           Trade    @relation(fields: [tradeId], references: [id])

  openerId        String
  opener          User     @relation("DisputeOpener", fields: [openerId], references: [id])
  defendantId     String
  defendant       User     @relation("DisputeDefendant", fields: [defendantId], references: [id])

  reason          String
  evidence        String?  // URL o hash IPFS de evidencia (screenshots, etc.)
  status          String @default("OPEN")
  resolution      String?  // texto explicativo de la resolución
  resolvedBy      String?  // alias del árbitro/multisig signer
  resolvedAt      DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Enums







// ============================================================
// MÓDULO: Retos P2P Gaming
// ============================================================
// Retos 1v1 con criptomonedas. Los usuarios vinculan su cuenta
// de juego (LoL, Valorant, CS2), apuestan USDT, juegan, y el
// sistema consulta la API oficial para determinar el ganador
// y liberar el pago automáticamente.

// Cuenta de juego vinculada por un usuario (ej: invocador de LoL)
model GameAccount {
  id              String   @id @default(cuid())
  userId          String
  game            String // LOL, VALORANT, CS2, ...
  accountRegion   String   // ej: "la1", "na1", "euw"
  accountId       String   // ID dentro del juego (PUUID, steamID, etc.)
  accountName     String   // nombre visible (invocador, tag)
  verifiedAt      DateTime @default(now())
  verificationHash String? // hash de verificación de propiedad

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([game, accountId, accountRegion])
  @@index([userId])
}

// Reto P2P: dos jugadores apuestan cripto sobre quién gana
model Challenge {
  id              String   @id @default(cuid())
  game            String
  mode            String   // "1v1-rank", "1v1-custom", "bo3", etc.
  stakeAmount     Float    // cantidad de USDT que apuesta cada jugador
  currency        String   @default("USDT")
  chain           String   @default("TRON") // chain del pago

  creatorId       String   // usuario que crea el reto
  opponentId      String?  // usuario que acepta (null si está abierto)
  winnerId        String?  // determinado al final

  // Cuentas de juego usadas en este reto
  creatorGameAccountId  String
  opponentGameAccountId String?

  // Match info
  matchId         String?  // ID del match en la API del juego (post-juego)
  matchData       String?  // JSON con datos crudos del match
  matchVerifiedAt DateTime?

  // Self-report (para juegos sin API: FIFA, CS2, CoD, etc.)
  reportedWinner     String?  // "creator" | "opponent" (quién se reporta como ganador)
  resultScreenshot   String?  // CID de IPFS con screenshot del resultado
  resultReportedAt   DateTime?
  resultConfirmedAt  DateTime?  // si el perdedor confirma
  resultDeadline     DateTime?  // 10 min para confirmar/disputar

  // Disputa
  disputeReason      String?
  disputeEvidence    String?  // CID de IPFS con evidencia adicional
  disputeOpenedAt    DateTime?
  disputeResolvedAt  DateTime?
  disputeResolver    String?  // alias del árbitro

  // Estado del escrow
  escrowAddress   String?
  escrowTxHash    String?

  // Pago al ganador (bot automático)
  payoutTxHash    String?  // tx hash del pago al ganador
  payoutAmount    Float?   // cantidad enviada al ganador
  payoutStatus    String?  @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  payoutError     String?
  payoutProcessedAt DateTime?

  status          String @default("OPEN")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  expiresAt       DateTime? // si nadie acepta, expira

  creator         User     @relation("ChallengeCreator", fields: [creatorId], references: [id])
  opponent        User?    @relation("ChallengeOpponent", fields: [opponentId], references: [id])
  winner          User?    @relation("ChallengeWinner", fields: [winnerId], references: [id])

  @@index([game, status])
  @@index([creatorId])
  @@index([opponentId])
}


